---
import Base from '../../../layouts/Base.astro';
import Plenario, { type AssentoDado, type Modo } from '../../../components/Plenario.astro';
import Carimbo from '../../../components/Carimbo.astro';
import { casasDisponiveis, meta, votacoes, votacao, porId, type Casa } from '../../../lib/dados';
import { corPartido } from '../../../lib/partidos';
import { ordenarPorBancada } from '../../../lib/plenario';
import { u, dataLonga, ementa, rotuloNorma, ROTULO_VOTO } from '../../../lib/formatar';
import { ROTULO_TEMA } from '../../../lib/categorias';

export function getStaticPaths() {
  return casasDisponiveis().flatMap((casa) => votacoes(casa).map((v) => ({ params: { casa, id: v.id } })));
}
const casa = Astro.params.casa as Casa;
const m = meta(casa);
const v = votacao(casa, Astro.params.id!);
const pessoas = porId(casa);

const COR: Record<string, string> = {
  sim: 'var(--verde)', nao: 'var(--carimbo)', abstencao: 'var(--ambar)', presidindo: 'var(--tinta-3)', ausente: '',
};
const linhas = Object.entries(v.votos).map(([id, voto]) => {
  const p = pessoas.get(id);
  const partido = (p && v.legislatura ? p.partidos_por_legislatura[String(v.legislatura)] : null) ?? p?.partido ?? '?';
  const nome = p?.nome ?? id.replace(/^nome:/, '').replace(/-/g, ' ');
  return { id, voto, partido, nome, p };
});
const ordem = ordenarPorBancada(linhas, (x) => x.partido, (x) => x.nome);
const assentos: AssentoDado[] = ordem.map((x) => ({
  id: x.id, nome: x.nome, partido: x.partido, foto: x.p?.foto, href: x.p ? u(`/${casa}/${x.p.slug}/`) : undefined,
  valores: {
    voto: { cor: COR[x.voto] ?? 'var(--tinta-3)', texto: ROTULO_VOTO[x.voto] ?? x.voto, vazio: x.voto === 'ausente' },
    partido: { cor: corPartido(x.partido), texto: `Bancada do ${x.partido}` },
  },
}));
const cont = { sim: 0, nao: 0, abstencao: 0, ausente: 0, presidindo: 0 } as Record<string, number>;
for (const x of linhas) cont[x.voto] = (cont[x.voto] ?? 0) + 1;
const modos: Modo[] = [
  {
    id: 'voto', rotulo: 'Voto',
    legenda: [
      { cor: COR.sim, texto: `Sim ${cont.sim}` }, { cor: COR.nao, texto: `Não ${cont.nao}` },
      { cor: COR.abstencao, texto: `Abstenção ${cont.abstencao}` }, { cor: '', texto: `Ausente ${cont.ausente}`, vazio: true },
    ],
    centro: { grande: `${cont.sim} × ${cont.nao}`, pequeno: 'sim × não' },
  },
  {
    id: 'partido', rotulo: 'Partido',
    legenda: [...new Set(ordem.map((x) => x.partido))].map((s) => ({ cor: corPartido(s), texto: s })),
    centro: { grande: String(linhas.length), pequeno: m.membros },
  },
];
const grupos = (['sim', 'nao', 'abstencao', 'ausente'] as const).map((k) => ({
  k, rotulo: { sim: 'Votaram sim', nao: 'Votaram não', abstencao: 'Abstiveram-se', ausente: 'Ausentes' }[k],
  lista: ordem.filter((x) => x.voto === k),
}));
const titulo = v.proposicao.id ? rotuloNorma(v.proposicao.id) : 'Votação nominal';
---
<Base casa={casa} titulo={`${titulo}: ${v.resultado ?? 'votação'} por ${cont.sim} a ${cont.nao}`}
      descricao={ementa(v.proposicao.ementa)}>
  <article class="envelope">
    <nav class="rubrica migalha"><a href={u(`/${casa}/votacoes/`)}>Votações nominais</a> / {dataLonga(v.data)}</nav>
    <header class="topo">
      <p class="rubrica">{v.sessao.numero} {v.sessao.tipo} · {v.objeto}</p>
      <h1 class="display">{titulo}</h1>
      <p class="ementa">{ementa(v.proposicao.ementa)}</p>
      <p class="meta">
        {v.proposicao.categoria && v.proposicao.categoria !== 'normativa'
          ? <Carimbo categoria={v.proposicao.categoria} />
          : v.proposicao.tema && <Carimbo texto={ROTULO_TEMA[v.proposicao.tema]} tom="tinta" />}
        <Carimbo texto={v.resultado ?? 'sem resultado'} tom={v.resultado === 'aprovado' ? 'tinta' : 'vermelho'} />
        {v.proposicao.autores.length > 0 && <span class="rubrica">Autoria: {v.proposicao.autores.join(', ')}</span>}
      </p>
      {v.resultado_frase && <p class="frase">“{v.resultado_frase}”</p>}
    </header>

    <section class="secao">
      <Plenario assentos={assentos} modos={modos} rotuloAria={`Votos: ${cont.sim} sim, ${cont.nao} não`} />
    </section>

    <section class="secao grupos">
      {grupos.filter((g) => g.lista.length).map((g) => (
        <div>
          <h2 class="display">{g.rotulo} <span class="n">{g.lista.length}</span></h2>
          <ul>
            {g.lista.map((x) => (
              <li>
                <span class="bolinha" style={`background:${corPartido(x.partido)}`}></span>
                {x.p ? <a href={u(`/${casa}/${x.p.slug}/`)}>{x.nome}</a> : x.nome}
                <small>{x.partido}</small>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>
    {v.fonte && <p class="rubrica"><a href={v.fonte} rel="noopener">Fonte oficial da votação ↗</a></p>}
  </article>
</Base>

<style>
  .migalha { margin: 28px 0 0; }
  .topo h1 { font-size: clamp(48px, 9vw, 104px); margin: 6px 0 10px; }
  .ementa { font-size: clamp(20px, 2.4vw, 26px); line-height: 1.3; max-width: 60ch; margin: 0 0 14px; }
  .meta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin: 0; }
  .frase { font-style: italic; color: var(--tinta-2); margin-top: 14px; }
  .grupos { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 32px; }
  .grupos h2 { font-size: 32px; margin: 0 0 8px; border-bottom: 2px solid var(--tinta); padding-bottom: 6px; }
  .n { color: var(--tinta-3); }
  .grupos ul { list-style: none; margin: 0; padding: 0; }
  .grupos li { display: flex; align-items: center; gap: 8px; padding: 4px 0; font-size: 17px; }
  .grupos small { font-family: var(--f-mono); font-size: 11px; color: var(--tinta-3); margin-left: auto; }
  .bolinha { width: 10px; height: 10px; border-radius: 50%; flex: none; }
</style>
