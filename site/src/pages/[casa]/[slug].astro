---
import Base from '../../layouts/Base.astro';
import Carimbo from '../../components/Carimbo.astro';
import ListaProducao, { type ItemProducao } from '../../components/ListaProducao.astro';
import ComoVotou from '../../components/ComoVotou.astro';
import { casasDisponiveis, meta, parlamentares, parlamentar, leis, type Casa } from '../../lib/dados';
import { corPartido } from '../../lib/partidos';
import { TEMA_FRASE } from '../../lib/categorias';
import { u, num, pct, pctTaxa, dataCurta, ementa, rotuloNorma } from '../../lib/formatar';
import { proposicoesVotadas, sentidoDoSim, slugProposicao, ultimaVotacao, ROTULO_PARTE } from '../../lib/proposicoes';

export function getStaticPaths() {
  return casasDisponiveis().flatMap((casa) =>
    parlamentares(casa).map((p) => ({ params: { casa, slug: p.slug } })));
}

const casa = Astro.params.casa as Casa;
const m = meta(casa);
const p = parlamentar(casa, Astro.params.slug!);
const urlLei = new Map(m.tem_leis ? leis(casa).map((l) => [l.id, l.url]) : []);

// Com base de leis (Câmara), a ficha mostra o que foi aprovado e o que foi proposto; sem ela (ALERJ),
// só os projetos apresentados.
const temLeis = m.tem_leis;
const leisOrd = p.lista_leis.filter((l) => l.tipo === 'LEI' || l.tipo === 'LC');
const titulosDL = p.lista_leis.filter((l) => l.tipo === 'DL');
const projetos = p.lista_proposicoes.filter((x) => x.tipo === 'PL' || x.tipo === 'PLC');
const pedidos = p.lista_proposicoes.filter((x) => x.tipo === 'REQINF');
const outras = p.lista_proposicoes.filter((x) => !['PL', 'PLC', 'REQINF'].includes(x.tipo));

// Projetos que passaram por votação nominal levam à página do projeto (quem votou a favor e contra).
const votadas = proposicoesVotadas(casa);
function votada(id: string | null | undefined) {
  const pv = id ? votadas.get(slugProposicao(id)) : undefined;
  if (!pv) return null;
  const href = u(`/${casa}/proposicoes/${pv.slug}/`);
  const v = pv.decisivas[pv.decisivas.length - 1];
  if (!v) return { href, texto: `votação nominal de ${ROTULO_PARTE[sentidoDoSim(casa, ultimaVotacao(pv)) ?? ''] ?? 'emenda'}` };
  if (!v.contagem) return { href, texto: 'votação nominal' };
  const [a, c] = sentidoDoSim(casa, v) === 'veto' ? [v.contagem.nao, v.contagem.sim] : [v.contagem.sim, v.contagem.nao];
  return { href, texto: `votação nominal: ${a} a favor, ${c} contra` };
}

const itensLeis: ItemProducao[] = leisOrd.map((l) => ({
  id: l.id, rotulo: rotuloNorma(l.id), url: l.url, data: l.data, ano: l.ano, ementa: l.ementa,
  resumo: l.resumo, categoria: l.categoria, simbolica: l.simbolica, tema: l.tema, leg: l.leg,
  n_autores: l.n_autores, coautores: l.coautores, status: l.status, votada: votada(l.projeto),
}));
const itensProjetos: ItemProducao[] = projetos.map((x) => ({
  id: x.id, rotulo: x.id.replace('-', ' '), url: votada(x.id)?.href ?? null, votada: votada(x.id), data: x.data, ano: x.id.split('/')[1], ementa: ementa(x.ementa),
  categoria: x.categoria ?? 'normativa', simbolica: !!x.simbolica, tema: x.tema, leg: x.leg,
  n_autores: 1 + x.coautores, lei: x.lei ? { rotulo: rotuloNorma(x.lei), url: urlLei.get(x.lei) ?? null } : null,
}));
const itensPedidos: ItemProducao[] = pedidos.map((x) => ({
  id: x.id, rotulo: `Req. ${x.id.split('-').slice(1).join('-')}`, url: null, data: x.data, ano: x.id.split('/')[1],
  ementa: ementa(x.ementa), categoria: 'normativa', simbolica: false, tema: x.tema, leg: x.leg, n_autores: 1 + x.coautores,
}));

/** Os três temas mais frequentes entre as regras e políticas, para a frase do topo. */
function temasPrincipais(xs: { simbolica: boolean | null; tema: string | null }[]) {
  const c: Record<string, number> = {};
  for (const x of xs) if (!x.simbolica && x.tema && x.tema !== 'outros') c[x.tema] = (c[x.tema] ?? 0) + 1;
  return Object.entries(c).sort((a, b) => b[1] - a[1]).slice(0, 3).map(([t]) => TEMA_FRASE[t]);
}
const emLista = (xs: string[]) => xs.join(', ').replace(/, ([^,]*)$/, ' e $1');

// --- mandatos ------------------------------------------------------------------------------
// Quem passou por mais de uma legislatura coberta pelos dados ganha o seletor; "todos" é a soma.
// As leis da Câmara vão até 2017, mas projetos, votos e presença (Tomoyo) só existem desde 2021: os
// mandatos "só com leis" mostram esses números como sem dados.
const anoLeis = temLeis ? m.ano_inicial_leis : m.ano_inicial;
const anoOutros = m.ano_inicial;
const mandatos = m.mandatos.filter((x) => p.mandatos.includes(x.leg));
const soLeis = mandatos.filter((x) => x.so_leis);
// quem chegou depois de 2017 tem "tudo" a partir do próprio primeiro mandato
const desde = mandatos.length ? Math.max(anoLeis, Number(mandatos[0].rotulo.slice(0, 4))) : anoLeis;
const semDados = `sem dados antes de ${anoOutros}`;
const variosMandatos = mandatos.length > 1;
const legDoAno = (ano: number) => m.mandatos.find((x) => Number(x.rotulo.slice(0, 4)) <= ano && ano <= Number(x.rotulo.slice(-4)))?.leg ?? null;

function numeros(leg: number | null) {
  const no = <T extends { leg: number | null }>(xs: T[]) => (leg == null ? xs : xs.filter((x) => x.leg === leg));
  const ls = no(leisOrd);
  const pls = no(projetos);
  const props = no(p.lista_proposicoes);
  const votos = no(p.lista_votos);
  const tipo = (t: string) => props.filter((x) => x.tipo === t).length;
  const votou = votos.filter((v) => v.voto === 'sim' || v.voto === 'nao' || v.voto === 'abstencao').length;
  const ausente = votos.filter((v) => v.voto === 'ausente').length;
  return {
    leis: ls.length,
    leisSimb: ls.filter((l) => l.simbolica).length,
    temas: temasPrincipais(temLeis ? ls : pls),
    peso: ls.reduce((s, l) => s + (l.n_autores ? 1 / l.n_autores : 0), 0),
    emGrupo: ls.filter((l) => l.n_autores > 1).length,
    pl: pls.length,
    plSimb: pls.filter((x) => x.simbolica).length,
    virou: pls.filter((x) => x.lei).length,
    reqinf: tipo('REQINF'), indicacoes: tipo('IND'), mocoes: tipo('MOC'),
    honrarias: props.filter((x) => (x.tipo === 'PDL' || x.tipo === 'PR') && x.categoria === 'honraria').length,
    titulos: no(titulosDL).filter((l) => l.categoria === 'honraria').length,
    participacao: votou + ausente ? votou / (votou + ausente) : null,
    contraPartido: votos.filter((v) => v.contra_partido).length,
  };
}

const membro = m.membro.charAt(0).toUpperCase() + m.membro.slice(1);
const situacao = p.em_exercicio ? `${membro} em exercício` : `Ex-${m.membro}`;
const inicial = p.nome.split(/\s+/).filter((x) => !/^(dr|dra|prof|profa)\.?$/i.test(x)).slice(0, 2).map((x) => x[0]).join('');

const visoes = [
  { chave: 'todos', leg: null as number | null,
    quando: variosMandatos || mandatos.length === 0 ? `Desde ${desde}` : `No mandato ${mandatos[0].rotulo}`,
    curto: 'Tudo', longo: ` desde ${desde}`, soLeis: false,
    // no "tudo", projetos e votos começam depois das leis
    sufixo: desde < anoOutros && (variosMandatos || mandatos.length === 0) ? ` desde ${anoOutros}` : '' },
  ...(variosMandatos ? mandatos.map((x) => ({ chave: String(x.leg), leg: x.leg as number | null,
    quando: `No mandato ${x.rotulo}`, curto: x.rotulo, longo: '', soLeis: !!x.so_leis, sufixo: '' })) : []),
].map((v) => {
  const n = numeros(v.leg);
  const total = temLeis ? n.leis : n.pl;
  const simb = temLeis ? n.leisSimb : n.plSimb;
  const regras = total - simb;
  // primeiro o que cria regra ou política, com os temas; depois as homenagens, sem juízo de valor
  const partes = [
    regras && `${num(regras)} de regras e políticas${n.temas.length ? `, sobretudo em ${emLista(n.temas)}` : ''}`,
    simb && `${num(simb)} de homenagens, ${temLeis ? 'nomes de rua' : 'nomes de lugar'}, datas comemorativas ou patrimônio`,
  ].filter(Boolean).join('; ');
  const frase = temLeis
    ? (total
      ? `${v.quando}, ${p.nome} (${p.partido}) assina ${num(total)} ${total === 1 ? 'lei aprovada' : 'leis aprovadas'} na ${m.curto}: ${partes}.${n.emGrupo ? ` ${num(n.emGrupo)} ${n.emGrupo === 1 ? 'foi assinada' : 'foram assinadas'} junto com colegas.` : ''}`
      : `${v.quando}, ${p.nome} (${p.partido}) não assina nenhuma lei aprovada na ${m.curto}.`)
    : (total
      ? `${v.quando}, ${p.nome} (${p.partido}) apresentou ${num(total)} ${total === 1 ? 'projeto' : 'projetos'} de lei na ${m.curto}: ${partes}.`
      : `${v.quando}, ${p.nome} (${p.partido}) não apresentou projetos de lei na ${m.curto}.`);
  return { ...v, n, total, simb, regras, frase, periodo: v.quando.replace(/^D/, 'd').replace(/^N/, 'n') };
});
const frase = visoes[0].frase;

// Listas curtas: basta mandar os primeiros de cada mandato (o script mostra os do mandato escolhido).
function primeiros<T extends { leg: number | null }>(xs: T[], n: number): T[] {
  const vistos = new Map<number | null, number>();
  return xs.filter((x, i) => {
    const k = (vistos.get(x.leg) ?? 0) + 1;
    vistos.set(x.leg, k);
    return i < n || k <= n;
  });
}
const semDadosDe = (oQue: string) =>
  (soLeis.length ? { legs: soLeis.map((x) => x.leg), msg: `${oQue} só estão disponíveis a partir de ${anoOutros}.` } : undefined);
const outrasCurtas = primeiros(outras, 12);
const honrariasCurtas = primeiros(titulosDL, 10);
const anosPresenca = Object.entries(p.presenca).sort((a, b) => Number(b[0]) - Number(a[0]));
const NOME_TIPO: Record<string, string> = {
  REQINF: 'Pedido de informação', IND: 'Indicação', MOC: 'Moção', PDL: 'Decreto legislativo', PR: 'Resolução',
  PELOM: 'Emenda à Lei Orgânica', PEC: 'Emenda à Constituição',
};
---
<Base casa={casa} titulo={`${p.nome} (${p.partido})`} descricao={frase} imagem={p.foto}>
  <article class="envelope ficha" data-ficha>
    <nav class="rubrica migalha"><a href={u(casa === 'camara' ? '/' : `/${casa}/`)}>{m.curto}</a> / {m.membros}</nav>

    <header class="topo surge">
      <div class="retrato" style={`--cor-partido:${corPartido(p.partido)}`}>
        {p.foto ? <img src={u(`/${p.foto}`)} alt={`Foto de ${p.nome}`} width="260" height="320" />
                : <div class="sem-retrato display">{inicial}</div>}
        <span class="faixa rubrica">{p.partido}</span>
      </div>
      <div class="identidade">
        <p class="rubrica">{situacao}{mandatos.length > 0 && ` · ${mandatos.length > 1 ? 'mandatos' : 'mandato'} ${mandatos.map((x) => x.rotulo).join(', ').replace(/, ([^,]*)$/, ' e $1')}`}</p>
        <h1 class="display">{p.nome}</h1>
        {p.nome_civil && p.nome_civil !== p.nome && <p class="civil">{p.nome_civil}</p>}
        {visoes.map((v, i) => <p class="frase" data-mandato-so={v.chave} hidden={i > 0}>{v.frase}</p>)}
        <div class="acoes">
          <button class="botao" type="button" data-copiar={`${frase} ${new URL(Astro.url.pathname, Astro.site).href}`}>Copiar resumo</button>
          {p.perfil_url && <a class="botao" href={p.perfil_url} rel="noopener">Perfil oficial ↗</a>}
        </div>
      </div>
    </header>

    {variosMandatos && (
      <nav class="mandatos" aria-label="Escolher mandato" data-mandatos>
        <span class="rubrica">Ver</span>
        {visoes.map((v, i) => (
          <button class="botao" type="button" data-mandato={v.chave} aria-pressed={String(i === 0)}>
            {i > 0 && <span class="longo">Mandato </span>}{v.curto}{v.longo && <span class="longo">{v.longo}</span>}
          </button>
        ))}
      </nav>
    )}

    {visoes.map((v, i) => (
      <section class:list={['boletim', { 'sem-seletor': !variosMandatos }]} aria-label={`Números ${v.periodo}`}
               data-mandato-so={v.chave} hidden={i > 0}>
        {temLeis ? (
          <>
            <div class="celula destaque">
              <span class="numero-gigante">{num(v.n.leis)}</span>
              <span class="rubrica">leis aprovadas {v.periodo}</span>
            </div>
            <div class="celula">
              <span class="numero-gigante azul-regras">{num(v.regras)}</span>
              <span class="rubrica">de regras e políticas ({pct(v.regras, v.total)}%)</span>
            </div>
            <div class="celula">
              <span class="numero-gigante ocre">{num(v.simb)}</span>
              <span class="rubrica">simbólicas: homenagens, nomes, datas e patrimônio ({pct(v.simb, v.total)}%)</span>
            </div>
            <div class="celula">
              <span class="numero-gigante">{num(v.n.peso, 1)}</span>
              <span class="rubrica">peso real: cada lei dividida pelo nº de autores</span>
            </div>
          </>
        ) : (
          <>
            <div class="celula destaque">
              <span class="numero-gigante">{num(v.n.pl)}</span>
              <span class="rubrica">projetos de lei apresentados {v.periodo}</span>
            </div>
            <div class="celula">
              <span class="numero-gigante azul-regras">{num(v.regras)}</span>
              <span class="rubrica">de regras e políticas ({pct(v.regras, v.total)}%)</span>
            </div>
            <div class="celula">
              <span class="numero-gigante ocre">{num(v.simb)}</span>
              <span class="rubrica">simbólicos: homenagens, nomes, datas e patrimônio ({pct(v.simb, v.total)}%)</span>
            </div>
            <div class="celula">
              <span class="numero-gigante">{num(v.n.mocoes)}</span>
              <span class="rubrica">moções de aplauso, louvor ou repúdio</span>
            </div>
          </>
        )}
        {!temLeis && (
          <div class="celula">
            <span class="numero-gigante">{num(v.n.indicacoes)}</span>
            <span class="rubrica">indicações (pedidos ao governo)</span>
          </div>
        )}
        {temLeis && (
          <div class="celula">
            <span class="numero-gigante">{v.soLeis ? '—' : num(v.n.pl)}</span>
            <span class="rubrica">{v.soLeis ? `projetos de lei: ${semDados}` : `projetos de lei apresentados${v.sufixo}; ${num(v.n.virou)} viraram lei`}</span>
          </div>
        )}
        <div class="celula">
          <span class="numero-gigante">{v.soLeis ? '—' : num(v.n.reqinf)}</span>
          <span class="rubrica">pedidos de informação ao Executivo{v.soLeis ? `: ${semDados}` : v.sufixo}</span>
        </div>
        <div class="celula">
          <span class="numero-gigante">{v.soLeis ? '—' : pctTaxa(v.n.participacao)}</span>
          <span class="rubrica">presença nas votações nominais{v.soLeis ? `: ${semDados}` : v.sufixo}</span>
        </div>
        <div class="celula">
          <span class="numero-gigante">{v.soLeis ? '—' : num(v.n.contraPartido)}</span>
          <span class="rubrica">votos contra a maioria do partido{v.soLeis ? `: ${semDados}` : v.sufixo}</span>
        </div>
      </section>
    ))}

    {temLeis && itensLeis.length > 0 && (
      <ListaProducao id="leis" titulo="O que aprovou" plural="leis" sub={`com o nome de ${p.nome}`} feminino
                     itens={itensLeis} extra="grupo" />
    )}

    {itensProjetos.length > 0 ? (
      <ListaProducao id="projetos" titulo="O que propôs" plural="projetos de lei"
                     sub={`protocolados${desde < anoOutros ? ` desde ${anoOutros}` : ''} com o nome de ${p.nome}`} feminino={false}
                     semDados={semDadosDe('Os projetos protocolados')}
                     itens={itensProjetos} extra={temLeis ? 'virou' : undefined}
                     nota={temLeis ? 'Conta os projetos em que o nome já aparece no protocolo. Muitas leis ganham coautores durante a tramitação, por isso o número de leis aprovadas pode passar o de projetos que viraram lei.' : undefined} />
    ) : (
      <section class="secao">
        <header><h2 class="display">O que propôs</h2></header>
        <p class="rubrica">Nenhum projeto de lei protocolado desde {anoOutros}.</p>
      </section>
    )}

    <ComoVotou casa={casa} votos={p.lista_votos} semDados={semDadosDe('As votações nominais')} />

    {itensPedidos.length > 0 && (
      <ListaProducao id="pedidos" titulo="O que perguntou" plural="pedidos de informação"
                     sub={`ao Executivo${desde < anoOutros ? ` desde ${anoOutros}` : ''} com o nome de ${p.nome}`} feminino={false}
                     itens={itensPedidos} categorias={false} rotuloTemas="Por tema" limite={20}
                     semDados={semDadosDe('Os pedidos de informação')}
                     nota="O requerimento de informação obriga o governo a responder e é a principal ferramenta de fiscalização. A quantidade não diz a qualidade: o tema e o texto de cada pedido estão abaixo." />
    )}

    <div class="duas-colunas">
      <section class="secao">
        <header>
          <h2 class="display">Outras proposições</h2>
          <span class="rubrica">{temLeis ? 'títulos, resoluções, emendas à Lei Orgânica' : 'indicações, moções, títulos'}</span>
        </header>
        {outras.length === 0 ? <p class="rubrica">Nada encontrado.</p> : (
          <ul class="lista-simples" data-lista-curta data-limite="12">
            {soLeis.map((x) => <li class="aviso rubrica" data-leg={x.leg} data-aviso hidden>Sem dados de {x.rotulo}: as proposições só estão disponíveis a partir de {anoOutros}.</li>)}
            {outrasCurtas.map((x, i) => (
              <li data-leg={x.leg ?? ''} hidden={i >= 12}>
                <span class="rubrica">{dataCurta(x.data)} · {NOME_TIPO[x.tipo] ?? x.tipo} {x.id.split('-').slice(1).join('-')}</span>
                <span class="ementa-curta">{ementa(x.ementa)}</span>
                {x.simbolica && <Carimbo categoria={x.categoria} pequeno />}
              </li>
            ))}
          </ul>
        )}
      </section>

      <div>
        {anosPresenca.length > 0 && (
          <section class="secao">
            <header><h2 class="display">Faltas</h2><span class="rubrica">frequência mensal publicada pela casa</span></header>
            <table class="tabela">
              <thead><tr><th>Ano</th><th>Faltas</th><th>Abonadas</th><th>Sem justificativa</th></tr></thead>
              <tbody data-lista-curta>
                {soLeis.map((x) => <tr data-leg={x.leg} data-aviso hidden><td colspan="4" class="aviso rubrica">Sem dados de {x.rotulo}: a frequência só está disponível a partir de {anoOutros}.</td></tr>)}
                {anosPresenca.map(([ano, f]) => (
                  <tr data-leg={legDoAno(Number(ano)) ?? ''}><td>{ano}</td><td>{f.faltas}</td><td>{f.abonadas}</td><td class:list={[{ vermelho: f.total > 0 }]}>{f.total}</td></tr>
                ))}
              </tbody>
            </table>
          </section>
        )}
        {titulosDL.length > 0 && (
          <section class="secao">
            <header><h2 class="display">Honrarias</h2><span class="rubrica">decretos legislativos</span></header>
            <ul class="lista-simples" data-lista-curta data-limite="10">
              {honrariasCurtas.map((h, i) => (
                <li data-leg={h.leg ?? ''} hidden={i >= 10}><span class="rubrica">{rotuloNorma(h.id)}</span><span class="ementa-curta">{h.ementa}</span></li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>
  </article>
</Base>

<style>
  .migalha { margin: 28px 0 0; }
  .migalha a { text-decoration: none; }
  .topo { display: grid; grid-template-columns: minmax(180px, 260px) 1fr; gap: clamp(20px, 4vw, 48px); margin-top: 18px; align-items: end; }
  .retrato { position: relative; border: 1.5px solid var(--tinta); box-shadow: 8px 8px 0 var(--cor-partido); background: var(--papel-3); }
  .retrato img { width: 100%; aspect-ratio: 13 / 16; object-fit: cover; filter: grayscale(1) contrast(1.15); }
  .sem-retrato { aspect-ratio: 13 / 16; display: grid; place-items: center; font-size: 110px; color: var(--tinta-3); }
  .faixa { position: absolute; left: -1.5px; bottom: 14px; background: var(--cor-partido); color: #fff; padding: 4px 10px; font-weight: 700; }
  .identidade h1 { font-size: clamp(56px, 10vw, 128px); margin: 4px 0 6px; overflow-wrap: anywhere; }
  .civil { margin: 0 0 10px; font-style: italic; color: var(--tinta-2); }
  .frase { font-size: clamp(19px, 2.2vw, 24px); line-height: 1.35; max-width: 46ch; margin: 10px 0 16px; }
  .acoes { display: flex; gap: 8px; flex-wrap: wrap; }
  .mandatos { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 44px; padding: 10px 0;
    position: sticky; top: 0; z-index: 6; background: var(--papel); border-bottom: 1px solid var(--linha); }
  .mandatos .rubrica { margin-right: 6px; }
  .boletim { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 3px solid var(--tinta); border-left: 1px solid var(--linha); margin-top: 18px; }
  .boletim.sem-seletor { margin-top: 48px; }
  .boletim[hidden], .frase[hidden] { display: none; }
  .celula { padding: 16px 16px 18px; border-right: 1px solid var(--linha); border-bottom: 1px solid var(--linha); display: grid; gap: 8px; align-content: start; }
  .celula .numero-gigante { font-size: clamp(44px, 6vw, 72px); }
  .celula .rubrica { font-size: 11px; line-height: 1.35; }
  .duas-colunas { display: grid; grid-template-columns: 1fr 1fr; gap: 0 48px; }
  .lista-simples { list-style: none; margin: 0; padding: 0; }
  .lista-simples li { display: grid; gap: 4px; padding: 12px 0; border-bottom: 1px solid var(--linha); justify-items: start; }
  .lista-simples li[hidden], .tabela tr[hidden] { display: none; }
  .ementa-curta { font-size: 17px; line-height: 1.35; text-decoration: none; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .aviso { color: var(--tinta-3); font-size: 12px; line-height: 1.5; }
  .tabela { width: 100%; border-collapse: collapse; font-family: var(--f-mono); font-size: 14px; }
  .tabela th, .tabela td { text-align: left; padding: 8px 6px; border-bottom: 1px solid var(--linha); }
  .tabela th { font-weight: 400; color: var(--tinta-3); text-transform: uppercase; font-size: 11px; letter-spacing: 0.08em; }
  @media (max-width: 860px) {
    .boletim { grid-template-columns: repeat(2, 1fr); }
    .duas-colunas { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .topo { grid-template-columns: 1fr; }
    .retrato { max-width: 220px; }
    .mandatos { gap: 4px; }
    .mandatos .botao { padding: 7px 9px; font-size: 12px; gap: 0; }
    .mandatos .longo { display: none; }
  }
</style>

<script>
  // Filtros da ficha: mandato (vale para a página toda), categoria/tema/filtro de cada lista e o
  // "mostrar mais". Cada item leva o mandato em data-leg; "todos" mostra tudo.
  const ficha = document.querySelector<HTMLElement>('[data-ficha]')!;
  const nf = (n: number) => n.toLocaleString('pt-BR');
  let mandato = 'todos';

  const doMandato = (el: HTMLElement) => mandato === 'todos' || el.dataset.leg === mandato;

  type Estado = { filtro: string; tema: string; limite: number };
  const estados = new Map<HTMLElement, Estado>();

  // filtro "campo:valor" compara com data-campo do item; valor vazio quer o campo ausente
  function passa(li: HTMLElement, e: Estado) {
    if (e.tema) return !li.dataset.simb && li.dataset.tema === e.tema;
    if (e.filtro === 'todas') return true;
    const [campo, valor] = e.filtro.split(':');
    return valor ? li.dataset[campo] === valor : !li.dataset[campo];
  }

  function aplicarSecao(secao: HTMLElement) {
    const e = estados.get(secao)!;
    const itens = [...secao.querySelectorAll<HTMLElement>('[data-item]')];
    const doPeriodo = itens.filter(doMandato);

    // barra e legenda por categoria, e contagem por tema, dentro do mandato
    const porCat: Record<string, number> = {};
    const porTema: Record<string, number> = {};
    for (const li of doPeriodo) {
      porCat[li.dataset.cat!] = (porCat[li.dataset.cat!] ?? 0) + 1;
      if (!li.dataset.simb && li.dataset.tema) porTema[li.dataset.tema] = (porTema[li.dataset.tema] ?? 0) + 1;
    }
    const total = doPeriodo.length;
    secao.querySelectorAll<HTMLElement>('.barra [data-cat]').forEach((s) => {
      s.style.width = `${(100 * (porCat[s.dataset.cat!] ?? 0)) / (total || 1)}%`;
    });
    secao.querySelectorAll<HTMLElement>('.leg li[data-cat]').forEach((li) => {
      const n = porCat[li.dataset.cat!] ?? 0;
      li.hidden = n === 0;
      li.querySelector('[data-n]')!.textContent = nf(n);
      li.querySelector('[data-p]')!.textContent = `${total ? Math.round((100 * n) / total) : 0}%`;
    });
    secao.querySelectorAll<HTMLElement>('[data-tema]').forEach((b) => {
      if (b.tagName !== 'BUTTON') return;
      const n = porTema[b.dataset.tema!] ?? 0;
      b.hidden = n === 0;
      b.querySelector('[data-n]')!.textContent = nf(n);
    });
    secao.querySelector('[data-total]')!.textContent = nf(total);

    // lista: filtro e "mostrar mais"
    let visiveis = 0;
    for (const li of itens) {
      const ok = doMandato(li) && passa(li, e);
      li.hidden = !ok || visiveis >= e.limite;
      if (ok) visiveis++;
    }
    const mais = secao.querySelector<HTMLElement>('[data-mais]')!;
    mais.hidden = visiveis <= e.limite;
    mais.querySelector('[data-faltam]')!.textContent = nf(visiveis - e.limite);
    const vazio = secao.querySelector<HTMLElement>('[data-vazio]')!;
    vazio.hidden = visiveis > 0;
    const semDados = (secao.dataset.semDados ?? '').split(',').includes(mandato);
    vazio.textContent = semDados ? secao.dataset.msgSemDados! : 'Nada neste filtro.';

    secao.querySelectorAll<HTMLElement>('[data-filtro]').forEach((b) =>
      b.setAttribute('aria-pressed', String(!e.tema && b.dataset.filtro === e.filtro)));
    secao.querySelectorAll<HTMLElement>('button[data-tema]').forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.tema === e.tema)));
  }

  function aplicarMandato() {
    ficha.dataset.mandato = mandato;
    document.dispatchEvent(new CustomEvent('mandato'));
    ficha.querySelectorAll<HTMLElement>('[data-mandato-so]').forEach((el) => { el.hidden = el.dataset.mandatoSo !== mandato; });
    ficha.querySelectorAll<HTMLElement>('[data-mandato]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mandato === mandato)));
    ficha.querySelectorAll<HTMLElement>('[data-lista-curta]').forEach((lista) => {
      const limite = Number(lista.dataset.limite ?? Infinity);
      let n = 0;
      for (const el of lista.children as HTMLCollectionOf<HTMLElement>) {
        const ok = el.dataset.aviso !== undefined ? el.dataset.leg === mandato : doMandato(el);
        el.hidden = !ok || n >= limite;
        if (ok) n++;
      }
    });
    estados.forEach((e, secao) => { e.limite = Number(secao.dataset.limite); aplicarSecao(secao); });
  }

  ficha.querySelectorAll<HTMLElement>('[data-secao]').forEach((secao) => {
    estados.set(secao, { filtro: 'todas', tema: '', limite: Number(secao.dataset.limite) });
    secao.addEventListener('click', (ev) => {
      const alvo = (ev.target as HTMLElement).closest<HTMLElement>('[data-filtro], button[data-tema], [data-mais]');
      if (!alvo) return;
      const e = estados.get(secao)!;
      if (alvo.dataset.mais !== undefined) e.limite += 60;
      else {
        if (alvo.dataset.filtro) {
          const f = alvo.dataset.filtro;
          e.filtro = f.startsWith('cat:') && e.filtro === f && !e.tema ? 'todas' : f;  // clicar de novo desliga
          e.tema = '';
        } else {
          e.tema = e.tema === alvo.dataset.tema ? '' : alvo.dataset.tema!;
          e.filtro = 'simb:';
        }
        e.limite = Number(secao.dataset.limite);
      }
      aplicarSecao(secao);
    });
  });

  ficha.querySelectorAll<HTMLButtonElement>('[data-mandato]').forEach((b) => b.addEventListener('click', () => {
    mandato = b.dataset.mandato!;
    const url = new URL(location.href);
    if (mandato === 'todos') url.searchParams.delete('mandato'); else url.searchParams.set('mandato', mandato);
    history.replaceState(null, '', url);
    aplicarMandato();
  }));

  // ?mandato=11 abre a ficha já no mandato
  const pedido = new URLSearchParams(location.search).get('mandato');
  if (pedido && ficha.querySelector(`[data-mandato="${CSS.escape(pedido)}"]`)) { mandato = pedido; aplicarMandato(); }

  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((b) => b.addEventListener('click', async () => {
    const visivel = ficha.querySelector<HTMLElement>('.frase:not([hidden])')?.textContent ?? '';
    const texto = `${visivel} ${location.href}`;
    try {
      if (navigator.share && matchMedia('(pointer: coarse)').matches) await navigator.share({ text: texto });
      else { await navigator.clipboard.writeText(texto); b.textContent = 'Copiado!'; setTimeout(() => (b.textContent = 'Copiar resumo'), 1800); }
    } catch { /* o usuário cancelou o compartilhamento */ }
  }));
</script>
