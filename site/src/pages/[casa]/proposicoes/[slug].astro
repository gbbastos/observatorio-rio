---
// Página de um projeto que passou por votação nominal: quem votou a favor e quem votou contra, em cada
// votação sobre o projeto (o voto no veto já traduzido), e a lista de todas as votações dele.
import Base from '../../../layouts/Base.astro';
import Plenario, { type AssentoDado, type Modo } from '../../../components/Plenario.astro';
import Carimbo from '../../../components/Carimbo.astro';
import { casasDisponiveis, meta, votacao, porId, parlamentares, type Casa, type Parlamentar } from '../../../lib/dados';
import { proposicoesVotadas, sentidoDoSim, posicaoDoVoto, dizPosicao, codigoSentido, explicaVeto, simbolica,
  ultimaVotacao } from '../../../lib/proposicoes';
import { dicaVeto } from '../../../lib/resumoVotos';
import { corPartido } from '../../../lib/partidos';
import { ordenarPorBancada } from '../../../lib/plenario';
import { u, num, dataCurta, dataLonga, ementa, rotuloNorma } from '../../../lib/formatar';
import { ROTULO_TEMA } from '../../../lib/categorias';

export function getStaticPaths() {
  return casasDisponiveis().flatMap((casa) =>
    [...proposicoesVotadas(casa).keys()].map((slug) => ({ params: { casa, slug } })));
}

const casa = Astro.params.casa as Casa;
const m = meta(casa);
const p = proposicoesVotadas(casa).get(Astro.params.slug!)!;
const pessoas = porId(casa);
const porNome = new Map(parlamentares(casa).map((x) => [x.nome, x]));
const ficha = (x: Parlamentar) => u(`/${casa}/${x.slug}/`);

const TIPO: Record<string, string> = {
  PL: 'Projeto de lei', PLC: 'Projeto de lei complementar', PDL: 'Projeto de decreto legislativo',
  PR: 'Projeto de resolução', PEC: 'Proposta de emenda à Constituição', PELOM: 'Proposta de emenda à Lei Orgânica',
};
const OBJETO: Record<string, string> = {
  projeto: 'Projeto', substitutivo: 'Substitutivo', redacao_final: 'Redação final', veto: 'Veto', emenda: 'Emenda',
};
const VOTACAO_DE: Record<string, string> = { veto: 'Votação do veto total', veto_parcial: 'Votação do veto parcial' };
const OBJETO_LONGO: Record<string, string> = {
  projeto: 'Votação do projeto', substitutivo: 'Votação do substitutivo', redacao_final: 'Votação da redação final',
  veto: 'Votação do veto', emenda: 'Votação de emenda',
};

// No plenário: as votações sobre o projeto inteiro (até as 4 mais recentes, deixando de lado as que
// ficaram sem quórum quando há outras); sem nenhuma, a última votação (emenda, veto parcial...), que
// fica em sim e não.
const comQuorum = p.decisivas.filter((v) => v.resultado !== 'sem_quorum');
const noPlenario = ((comQuorum.length ? comQuorum : p.decisivas).slice(-4) as typeof p.decisivas)
  .concat(p.decisivas.length ? [] : [ultimaVotacao(p)])
  .map((v) => ({ v, votos: votacao(casa, v.id).votos, s: sentidoDoSim(casa, v) }));

// Cadeiras: todo mundo que aparece nessas votações, com o partido da votação mais recente.
const gente = new Map<string, { id: string; nome: string; partido: string; x?: Parlamentar }>();
for (const { v, votos } of noPlenario) {
  for (const id of Object.keys(votos)) {
    const x = pessoas.get(id);
    const partido = (x && v.legislatura ? x.partidos_por_legislatura[String(v.legislatura)] : null) ?? x?.partido ?? '?';
    gente.set(id, { id, nome: x?.nome ?? id.replace(/^nome:/, '').replace(/-/g, ' '), partido, x });
  }
}
const ordem = ordenarPorBancada([...gente.values()], (g) => g.partido, (g) => g.nome);

type Classe = 'favor' | 'contra' | 'sim' | 'nao' | 'abstencao' | 'presidindo' | 'ausente' | 'fora';
const COR: Record<Classe, string> = {
  favor: 'var(--verde)', contra: 'var(--carimbo)', sim: 'var(--verde)', nao: 'var(--carimbo)',
  abstencao: 'var(--ambar)', presidindo: 'var(--tinta-3)', ausente: '', fora: '',
};
const ROTULO: Record<Classe, string> = {
  favor: 'A favor', contra: 'Contra', sim: 'Sim', nao: 'Não', abstencao: 'Abstenção',
  presidindo: 'Presidindo', ausente: 'Ausentes', fora: '',
};
// nas votações que não são do projeto inteiro, o que o sim e o não fizeram
const SIM_NAO: Record<string, [string, string]> = {
  emenda: ['Sim à emenda', 'Não à emenda'],
  veto_parcial: ['Sim: manter o veto', 'Não: derrubar o veto'],
  veto_alerj: ['Sim: derrubar o veto', 'Não: manter o veto'],
};
const VAZIO = new Set<Classe>(['ausente', 'fora']);
const TEXTO: Record<Classe, string> = {
  favor: 'A favor do projeto', contra: 'Contra o projeto', sim: 'Votou sim', nao: 'Votou não',
  abstencao: 'Absteve-se', presidindo: 'Presidia a sessão', ausente: 'Ausente', fora: 'Não estava na Casa nesta votação',
};
const CODIGO_VOTO: Record<string, string> = { sim: 's', nao: 'n' };

const blocos = noPlenario.map(({ v, votos, s }, k) => {
  const diz = dizPosicao(s);
  const linhas = ordem.map((g) => {
    const voto = votos[g.id];
    const pos = voto ? posicaoDoVoto(s, voto) : null;
    const c: Classe = !voto ? 'fora' : pos ?? (voto === 'sim' || voto === 'nao' ? voto : 'ausente');
    return { g, voto, c };
  });
  const cont: Partial<Record<Classe, number>> = {};
  for (const l of linhas) cont[l.c] = (cont[l.c] ?? 0) + 1;
  const [a, b]: Classe[] = diz ? ['favor', 'contra'] : ['sim', 'nao'];
  const rotulo = (c: Classe) => (c === 'sim' || c === 'nao' ? SIM_NAO[s ?? '']?.[c === 'sim' ? 0 : 1] : null) ?? ROTULO[c];
  // texto do cartão: a posição e o voto de verdade ("A favor do projeto (votou não, para derrubar o veto)")
  const texto = (c: Classe, voto?: string) => {
    if (!voto || (voto !== 'sim' && voto !== 'nao')) return TEXTO[c];
    const dica = dicaVeto(codigoSentido(s), CODIGO_VOTO[voto]);
    const votou = `votou ${voto === 'sim' ? 'sim' : 'não'}`;
    if (diz) return `${TEXTO[c]} (${dica ? `${votou}, ${dica.replace(/ \(.*\)$/, '')}` : votou})`;
    if (s === 'emenda') return `${TEXTO[c]} à emenda`;
    return dica ? `${TEXTO[c]}, ${dica}` : TEXTO[c];
  };
  return {
    id: `v${k}`, v, s, diz, linhas, cont, a, b, rotulo, texto,
    grupos: ([a, b, 'abstencao', 'presidindo', 'ausente'] as Classe[])
      .map((c) => ({ c, lista: linhas.filter((l) => l.c === c) })).filter((x) => x.lista.length),
  };
});
const atual = blocos[blocos.length - 1];
const chamada = atual.diz ? 'Quem votou a favor e quem votou contra' : 'Como votaram';

// rótulo dos botões: "Projeto · 18 ago 2026"; duas votações iguais no mesmo dia ganham a ordem
const vistos: Record<string, number> = {};
const rotulos = blocos.map((bl) => {
  const r = `${OBJETO[bl.v.objeto ?? ''] ?? 'Votação'} · ${dataCurta(bl.v.data)}`;
  vistos[r] = (vistos[r] ?? 0) + 1;
  return vistos[r] > 1 ? `${r} (${vistos[r]}ª)` : r;
});
const modos: Modo[] = [
  ...blocos.map((bl, k) => ({
    id: bl.id, rotulo: blocos.length > 1 ? rotulos[k] : 'Votos',
    legenda: [
      { cor: COR[bl.a], texto: `${bl.rotulo(bl.a)} ${bl.cont[bl.a] ?? 0}` }, { cor: COR[bl.b], texto: `${bl.rotulo(bl.b)} ${bl.cont[bl.b] ?? 0}` },
      { cor: COR.abstencao, texto: `Abstenção ${bl.cont.abstencao ?? 0}` },
      { cor: '', texto: `Ausente ${bl.cont.ausente ?? 0}`, vazio: true },
    ],
    centro: { grande: `${bl.cont[bl.a] ?? 0} × ${bl.cont[bl.b] ?? 0}`, pequeno: bl.diz ? 'a favor × contra' : 'sim × não' },
  })),
  {
    id: 'partido', rotulo: 'Partido',
    legenda: [...new Set(ordem.map((g) => g.partido))].map((s) => ({ cor: corPartido(s), texto: s })),
    centro: { grande: String(ordem.length), pequeno: m.membros },
  },
];
const assentos: AssentoDado[] = ordem.map((g) => ({
  id: g.id, nome: g.nome, partido: g.partido, foto: g.x?.foto, href: g.x ? ficha(g.x) : undefined,
  valores: {
    ...Object.fromEntries(blocos.map((bl) => {
      const l = bl.linhas.find((x) => x.g.id === g.id)!;
      return [bl.id, { cor: COR[l.c], texto: bl.texto(l.c, l.voto), vazio: VAZIO.has(l.c) }];
    })),
    partido: { cor: corPartido(g.partido), texto: `Bancada do ${g.partido}` },
  },
}));

const autores = p.autores.map((nome) => ({ nome, x: porNome.get(nome) }));
const titulo = rotuloNorma(p.id);
const temaOuCategoria = simbolica(p) ? null : p.tema;
const resultadoCurto = (r: string | null) => r?.replace('_', ' ') ?? 'sem resultado';
const PARTE: Record<string, string> = { emenda: 'de emendas', veto_parcial: 'de um veto parcial', veto_alerj: 'do veto' };
const frase = atual.diz
  ? `Na votação mais recente sobre o projeto, em ${dataLonga(atual.v.data)}, ${num(atual.cont.favor ?? 0)} votaram a favor e ${num(atual.cont.contra ?? 0)} contra.`
  : `Não há votação nominal do projeto inteiro, só ${PARTE[atual.s ?? ''] ?? 'de partes dele'}. Por isso os votos abaixo ficam em sim e não, sem a favor ou contra o projeto.`;
---
<Base casa={casa} titulo={`${titulo}: ${chamada.toLowerCase()}`} descricao={ementa(p.ementa)}>
  <article class="envelope" data-projeto-pagina>
    <nav class="rubrica migalha"><a href={u(`/${casa}/votacoes/`)}>Votações nominais</a> / {titulo}</nav>
    <header class="topo">
      <p class="rubrica">
        {TIPO[p.tipo ?? ''] ?? 'Proposição'}{p.ficha?.data && ` · protocolado em ${dataLonga(p.ficha.data)}`}
      </p>
      <h1 class="display">{titulo}</h1>
      <p class="ementa">{ementa(p.ementa)}</p>
      <p class="meta">
        {temaOuCategoria
          ? <Carimbo texto={ROTULO_TEMA[temaOuCategoria]} tom="tinta" />
          : p.categoria && <Carimbo categoria={p.categoria} />}
        {p.lei && (p.lei.url
          ? <a class="virou" href={p.lei.url} rel="noopener">virou {rotuloNorma(p.lei.id)} ↗</a>
          : <span class="virou">virou {rotuloNorma(p.lei.id)}</span>)}
        {autores.length > 0 && (
          <span class="rubrica">Autoria: {autores.map((a, i) => (
            <>{a.x ? <a href={ficha(a.x)}>{a.nome}</a> : a.nome}{i < autores.length - 1 ? ', ' : ''}</>
          ))}</span>
        )}
      </p>
      <p class="frase">{frase}</p>
    </header>

    <section class="secao">
      <header>
        <h2 class="display">{chamada}</h2>
        {blocos.length > 1 && <span class="rubrica">escolha a votação nos botões</span>}
      </header>
      <Plenario assentos={assentos} modos={modos} modoInicial={atual.id}
                rotuloAria={`${titulo}: ${atual.cont[atual.a] ?? 0} ${atual.diz ? 'a favor' : 'sim'}, ${atual.cont[atual.b] ?? 0} ${atual.diz ? 'contra' : 'não'}`} />
    </section>

    {blocos.map((bl) => (
      <section class="secao bloco" data-bloco={bl.id} hidden={bl !== atual}>
        <p class="sobre">
          <strong>{VOTACAO_DE[bl.s ?? ''] ?? OBJETO_LONGO[bl.v.objeto ?? ''] ?? 'Votação'} em {dataLonga(bl.v.data)}:</strong>{' '}
          {resultadoCurto(bl.v.resultado)}{bl.v.contagem && ` por ${bl.v.contagem.sim} a ${bl.v.contagem.nao}`}.{' '}
          <a href={u(`/${casa}/votacoes/${bl.v.id}/`)}>ver a votação →</a>
        </p>
        {explicaVeto(casa, bl.s) && <p class="explica">{explicaVeto(casa, bl.s)}</p>}
        {bl.s === 'emenda' && <p class="explica">O voto numa emenda não diz se a pessoa apoia o projeto: diz só se aprova a mudança proposta.</p>}
        <div class="grupos">
          {bl.grupos.map((gr) => (
            <div>
              <h3 class="display">{bl.rotulo(gr.c)} <span class="n">{gr.lista.length}</span></h3>
              <ul>
                {gr.lista.map((l) => (
                  <li>
                    <span class="bolinha" style={`background:${corPartido(l.g.partido)}`}></span>
                    {l.g.x ? <a href={ficha(l.g.x)}>{l.g.nome}</a> : l.g.nome}
                    <small>{l.g.partido}</small>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    ))}

    <section class="secao">
      <header>
        <h2 class="display">Todas as votações nominais</h2>
        <span class="rubrica">{num(p.votacoes.length)} {p.votacoes.length === 1 ? 'votação' : 'votações'} deste projeto</span>
      </header>
      <ol class="todas">
        {[...p.votacoes].reverse().map((v) => (
          <li>
            <a href={u(`/${casa}/votacoes/${v.id}/`)}>
              <span class="rubrica">{dataCurta(v.data)}</span>
              <span class="obj">{OBJETO[v.objeto ?? ''] ?? 'Votação'}</span>
              <span class:list={['res', v.resultado === 'aprovado' || v.resultado === 'derrubado' ? 'ok' : v.resultado ? 'nao' : '']}>{resultadoCurto(v.resultado)}</span>
              {v.contagem && <span class="placar">{v.contagem.sim} sim × {v.contagem.nao} não</span>}
            </a>
          </li>
        ))}
      </ol>
    </section>
  </article>
</Base>

<style>
  .migalha { margin: 28px 0 0; }
  .topo h1 { font-size: clamp(48px, 9vw, 104px); margin: 6px 0 10px; }
  .ementa { font-size: clamp(20px, 2.4vw, 26px); line-height: 1.3; max-width: 60ch; margin: 0 0 14px; }
  .meta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin: 0; }
  .virou { font-family: var(--f-mono); font-size: 14px; font-weight: 700; color: var(--verde); }
  .frase { font-size: 19px; color: var(--tinta-2); margin: 16px 0 0; max-width: 65ch; }
  .secao > header h2 { font-size: clamp(30px, 5vw, 48px); }
  .bloco[hidden] { display: none; }
  .bloco { padding-top: 0; }
  .sobre { font-size: 18px; margin: 0 0 6px; }
  .explica { font-size: 16px; color: var(--tinta-2); margin: 0 0 18px; max-width: 75ch; padding-left: 12px; border-left: 3px solid var(--ambar); }
  .grupos { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 32px; margin-top: 18px; }
  .grupos h3 { font-size: 32px; margin: 0 0 8px; border-bottom: 2px solid var(--tinta); padding-bottom: 6px; }
  .n { color: var(--tinta-3); }
  .grupos ul { list-style: none; margin: 0; padding: 0; }
  .grupos li { display: flex; align-items: center; gap: 8px; padding: 4px 0; font-size: 17px; }
  .grupos small { font-family: var(--f-mono); font-size: 11px; color: var(--tinta-3); margin-left: auto; }
  .bolinha { width: 10px; height: 10px; border-radius: 50%; flex: none; }
  .todas { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--tinta); }
  .todas a { display: grid; grid-template-columns: 110px 130px 140px 1fr; gap: 12px; align-items: baseline; padding: 10px 0;
    border-bottom: 1px solid var(--linha); text-decoration: none; }
  .obj { font-weight: 700; }
  .res, .placar { font-family: var(--f-mono); font-size: 13px; text-transform: uppercase; }
  .ok { color: var(--verde); }
  .nao { color: var(--carimbo); }
  @media (max-width: 600px) {
    .todas a { grid-template-columns: 1fr 1fr; gap: 4px 12px; }
  }
</style>

<script>
  // a lista de nomes acompanha a votação escolhida no plenário
  document.addEventListener('plenario:modo', (ev) => {
    const modo = (ev as CustomEvent<string>).detail;
    if (!modo.startsWith('v')) return;
    document.querySelectorAll<HTMLElement>('[data-bloco]').forEach((b) => { b.hidden = b.dataset.bloco !== modo; });
  });
</script>
